lease {
  interface "ens33";
  fixed-address 192.168.150.136;
  option subnet-mask 255.255.255.0;
  option routers 192.168.150.2;
  option dhcp-lease-time 1800;
  option dhcp-message-type 5;
  option domain-name-servers 192.168.150.2;
  option dhcp-server-identifier 192.168.150.254;
  option broadcast-address 192.168.150.255;
  option netbios-name-servers 192.168.150.2;
  option domain-name "localdomain";
  renew 6 2022/01/22 06:45:58;
  rebind 6 2022/01/22 06:57:28;
  expire 6 2022/01/22 07:01:13;
}
